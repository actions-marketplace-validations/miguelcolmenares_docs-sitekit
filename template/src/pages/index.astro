---
import { loadSite } from "../infrastructure";
import CtaBand from "../presentation/components/site/CtaBand.astro";
import { FeatureGrid } from "../presentation/components/site/FeatureGrid";
import Hero from "../presentation/components/site/Hero.astro";
import { CardGrid, ItemCard } from "../presentation/components/site/ItemCard";
import { SectionHeader } from "../presentation/components/site/SectionHeader";
import BaseLayout from "../presentation/layouts/BaseLayout.astro";

const site = loadSite();
const { config, href } = site;
const docs = site.documents.filter((document) => document.collection === "docs").slice(0, 6);
const examples = site.documents.filter((document) => document.collection === "examples").slice(0, 3);
// A link in the config that starts with "/" is a path on this site, so it gets the base.
const resolve = (link: { label: string; href: string }) => ({ ...link, href: link.href.startsWith("/") ? href(link.href) : link.href });
---

<BaseLayout>
  <Hero
    badge={config.hero.badge}
    title={config.hero.title}
    lede={config.hero.lede}
    command={config.site.installCommand}
    primary={resolve(config.hero.primary)}
    secondary={config.hero.secondary && resolve(config.hero.secondary)}
  />

  {
    config.features.length > 0 && (
      <section class="mx-auto max-w-site px-5 py-20">
        <SectionHeader eyebrow="01 · Why" title={`Why ${config.site.name}`} />
        <FeatureGrid features={config.features} />
      </section>
    )
  }

  {
    docs.length > 0 && (
      <section class="mx-auto max-w-site border-t border-border px-5 py-20">
        <SectionHeader eyebrow={`${config.features.length > 0 ? "02" : "01"} · Documentation`} title="Start here" lede="Everything you need, in reading order.">
          <a href={href("docs/")} class="inline-flex min-h-11 items-center text-sm text-fg-muted hover:text-fg-bright">All docs →</a>
        </SectionHeader>
        <CardGrid>
          {docs.map((document) => <ItemCard href={document.route} title={document.title} description={document.description} hint="Read" />)}
        </CardGrid>
      </section>
    )
  }

  {
    examples.length > 0 && (
      <section class="mx-auto max-w-site border-t border-border px-5 py-20">
        <SectionHeader eyebrow="Examples" title="See it in use">
          <a href={href("examples/")} class="inline-flex min-h-11 items-center text-sm text-fg-muted hover:text-fg-bright">All examples →</a>
        </SectionHeader>
        <CardGrid>
          {examples.map((document) => <ItemCard href={document.route} title={document.title} description={document.description} hint="Open" />)}
        </CardGrid>
      </section>
    )
  }

  <CtaBand
    title={`Start using ${config.site.name}`}
    command={config.site.installCommand}
    primary={resolve(config.hero.primary)}
    secondary={config.site.repository ? { label: "View on GitHub", href: config.site.repository } : undefined}
  />
</BaseLayout>
