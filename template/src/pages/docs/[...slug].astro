---
import { loadSite } from "../../infrastructure";
import type { Document } from "../../domain";
import CollectionIndex from "../../presentation/layouts/CollectionIndex.astro";
import DocPage from "../../presentation/layouts/DocPage.astro";

export async function getStaticPaths() {
  const site = loadSite();
  const documents = site.documents.filter((document) => document.collection === "docs");
  if (documents.length === 0) return [];
  const detail = await Promise.all(
    documents.map(async (doc) => ({ params: { slug: doc.slug }, props: { doc, documents, ...(await site.render(doc)) } })),
  );
  return [{ params: { slug: undefined }, props: { documents } }, ...detail];
}

const { doc, html, headings, documents } = Astro.props as {
  doc?: Document;
  html?: string;
  headings?: { depth: number; slug: string; text: string }[];
  documents: Document[];
};
const { href } = loadSite();
---

{
  doc && html !== undefined ? (
    <DocPage doc={doc} html={html} headings={headings ?? []} siblings={documents} collectionLabel="Docs" collectionHref={href("docs/")} homeHref={href("")} />
  ) : (
    <CollectionIndex title="Docs" lede="Guides and reference for using the project." documents={documents} />
  )
}
